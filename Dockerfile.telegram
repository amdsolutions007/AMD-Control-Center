# Telegram Approval Bot + Leke Leke Publisher — UNIFIED SERVICE
# Single container: CEO approval UI + inline Selenium posting

FROM python:3.9-slim

# Unbuffer Python output so logs are visible in Railway
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install Chromium + WebDriver + Xvfb (virtual display to bypass Cloudflare Turnstile)
RUN apt-get update && apt-get install -y \
    chromium \
    chromium-driver \
    xvfb \
    wget \
    curl \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libwayland-client0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Chrome binary paths for Selenium
ENV CHROME_BIN=/usr/bin/chromium
ENV CHROME_DRIVER=/usr/bin/chromedriver
# Virtual display — Chrome runs non-headless on :99 to pass Cloudflare Turnstile
ENV DISPLAY=:99

# Set working directory
WORKDIR /app

# Copy requirements
COPY requirements-telegram.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-telegram.txt

# Copy application files
COPY content_generator.py .
COPY graphic_generator.py .
COPY leke_leke_browser_automation.py .
COPY telegram_approval_bot.py .
COPY amd_badge.png .
COPY 36_states_data.json .

# DOME: Intel engine + vault
COPY tools/ ./tools/
COPY intelligence_vault/ ./intelligence_vault/

# Create necessary directories
RUN mkdir -p pending_posts approved_posts rejected_posts generated_graphics \
             tools intelligence_vault/live intelligence_vault/members/group intelligence_vault/members/profile

# Run Telegram Bot
CMD ["python", "telegram_approval_bot.py"]
