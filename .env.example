# AMD DIGITAL TWIN - Environment Variables
# Copy this file to .env and fill in your credentials

# Namecheap Private Email Password
SMTP_PASS=your_password_here

# OpenAI API Key (for existing systems)
OPENAI_API_KEY=your_openai_key_here

# Telegram Bot Token (for existing systems)
TELEGRAM_BOT_TOKEN=your_telegram_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ========================================
# GHOST WRITER PRO - NEW CREDENTIALS
# ========================================
# Get from: @BotFather on Telegram
# Steps: /newbot -> name your bot -> copy token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram user ID (CEO)
# Get from: @userinfobot on Telegram
# Send /start to @userinfobot and it will reply with your ID
CEO_TELEGRAM_ID=your_telegram_id_here

# Your Leke Leke account credentials
LEKE_LEKE_EMAIL=your_email@example.com
LEKE_LEKE_PASSWORD=your_password_here
LEKE_LEKE_BASE_URL=https://www.lekeelekee.com
LEKE_LEKE_GROUP_ID=4d183887-2d5a-47b0-8226-dd6939d29694

# ========================================
# AMD SYNC ENGINE - Phase 1 Config
# ========================================
# Poll interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL_SECS=300

# CEO Telegram ID (for Pulse alerts in Phase 2)
CEO_TELEGRAM_ID=your_telegram_id_here

# For future AI image generation
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
